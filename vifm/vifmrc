" colorscheme {{{

" カラースキームを順番に試す
colorscheme gruvbox Default-256 Default

" フォーカス行を下線にする
highlight CurrLine cterm=underline ctermbg=default

" }}}

" sets {{{

" インクリメンタルサーチ
set incsearch

" 大文字・小文字を区別せずに検索する
set ignorecase

" 検索文字に大文字が含まれていれば区別する
set smartcase

" Vifm内臓のファイル操作を使う
set syscalls

" 削除したファイルをゴミ箱へ移動する
set trash

" Enterで実行ファイルを直接実行しない
set norunexec

" 履歴数
set history=100

" Undo数
set undolevels=100

" 自然な数値順に並べる
set sortnumbers

" 日付の表示を変更する
set timefmt=%Y/%m/%d\ %H:%M

" xyzzyのファイラーっぽくヘルプを表示しておく
set statusline=" C:Copy D:Delete J:FuzzyJump ,J:FuzzyJump K:Mkdir M:Move N:New P:SyncToOther Q:Quit%N R:Rename S:SyncFromOther U:Unselect W:Preview yy:Yank .:ToggleDotfiles \\:Root ~:Home Space:Select"

" コマンドラインのTab補完候補を表示
set wildmenu

" 補完候補をポップアップ表示する
set wildstyle=popup

" キー、マーク、レジスタなどの候補を表示
set suggestoptions=normal,visual,view,otherpane,keys,marks,registers,delay:300

" カーソルの上下に余白を確保しない
set scrolloff=0

if $EDITOR != ''
  let &vicmd = $EDITOR
elseif executable('nvim')
  set vicmd=nvim
else
  set vicmd=vim
endif

if executable('bat')
  " 末尾が/でなければbatを使ってプレビューする
  fileviewer *[^/] bat --color=always --style=plain %c
endif

" }}}

" view sets {{{

" 一覧表示にする
windo set nolsview

" カラムを変更する
windo set viewcolumns='-{name}..,{# },12{perms},8{size},{# },16{mtime}'

" }}}

" keymaps {{{

" 設定ファイルを再読み込みする or :restart
nnoremap <F5> :<C-u>source $MYVIFMRC<CR>

" 1ペインの時には分割しそれ以外の時にはペインを移動する
nnoremap <silent> <Tab> :<C-u>if layoutis('only')
        \| vsplit
        \| else
        \| execute 'wincmd w'
        \| endif<CR>

" ファイルを移動する
nnoremap M :if layoutis('only')
      \| execute 'put!'
      \| else
      \| execute 'move'
      \| endif<CR>

" カレントディレクトリをクリップボードへコピー
nnoremap yd :!printf "%d" | pbcopy<CR>

" 選択ファイルのパスをクリップボードへコピー
nnoremap yf :!printf "%c:p" | pbcopy<CR>

nnoremap C :<C-u>copy<CR>
nnoremap D :<C-u>delete<CR>
nnoremap K :<C-u>mkdir<Space>
nnoremap N :<C-u>edit<Space>
nnoremap P :<C-u>sync<CR>
nnoremap Q :<C-u>quit<CR>
nnoremap R :<C-u>rename<Space>
nnoremap S :<C-u>cd %D<CR>
nnoremap U :<C-u>unselect *<CR>
nnoremap W :<C-u>view<CR>
nnoremap . :<C-u>set dotfiles!<CR>
nnoremap \ :<C-u>cd /<CR>
nnoremap ~ :<C-u>cd ~<CR>
nnoremap <Space> tj

" }}}

" fuzzy jump {{{

let g:jump_sources = ''

if executable('bat')
  let g:jump_preview = 'bat --color=always -pp -r :60 {}/README.* 2>/dev/null || ls -1a {}'
else
  let g:jump_preview = 'head -n 60 {}/README.* 2>/dev/null || ls -1a {}'
endif

if executable('ghq')
  let g:jump_sources = g:jump_sources . ' <(ghq list --full-path)'
else
  let g:jump_sources = g:jump_sources . ' <(find "${GHQ_ROOT:-$HOME/.ghq}" -mindepth 3 -maxdepth 3 -type d -print)'
endif

if executable('zoxide')
  let g:jump_sources = g:jump_sources . ' <(zoxide query --list)'
endif

let g:fuzzy_jump_command = 'cat ' . g:jump_sources . ' | sort -u | fzf --preview="' . g:jump_preview . '" 2>/dev/null'

" 現在のペイン
command! ccd :execute 'cd' fnameescape(term(g:fuzzy_jump_command))

" 反対側のペイン
command! ocd :execute 'winrun , cd' fnameescape(term(g:fuzzy_jump_command))

nnoremap J :<C-u>ccd<CR>
nnoremap <silent> ,J :<C-u>ocd<CR>

" }}}

